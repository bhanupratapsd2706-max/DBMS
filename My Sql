        WHEN age < 18 THEN 'Minor'
        WHEN age <= 21 THEN 'Young'
        ELSE 'Adult'
    END AS category
FROM Students;


-- Views

A view is a saved query that can be used like a table.

CREATE VIEW AdultStudents AS
SELECT id, name, age
FROM Students
WHERE age >= 18;

SELECT * FROM AdultStudents;

DROP VIEW AdultStudents;


-- Indexes
Indexes can speed up certain searches.

CREATE INDEX idx_student_name
ON Students(name);


To remove an index, syntax depends on the database.

MySQL:
DROP INDEX idx_student_name ON Students;


 Transactions — COMMIT and ROLLBACK

START TRANSACTION;

UPDATE Accounts

SET balance = balance - 500
WHERE account_id = 1;

UPDATE Accounts
SET balance = balance + 500
WHERE account_id = 2;

COMMIT;


Cancel uncommitted changes instead:
ROLLBACK;


These commands assume an Accounts table exists. Oracle starts transactions implicitly rather than using START TRANSACTION in the same way as MySQL.


-- SAVEPOINT
SAVEPOINT before_update;

UPDATE Students
SET age = 22
WHERE id = 1;

ROLLBACK TO SAVEPOINT before_update;


This rolls back changes made after the savepoint, subject to database-specific syntax.


-- GRANT and REVOKE
These commands control permissions; exact syntax and user setup depend on the DBMS.

GRANT SELECT ON Students TO analyst_user;

REVOKE SELECT ON Students FROM analyst_user;


-- Find Duplicate Emails
Common interview question:

SELECT email
FROM Person
GROUP BY email
HAVING COUNT(*) > 1;


-- Employees Earning More Than Their Manager
SELECT e.name AS Employee
FROM Employee e
JOIN Employee m
ON e.managerId = m.id
WHERE e.salary > m.salary;


-- Customers Who Never Ordered

SELECT c.name AS Customers
FROM Customers c
WHERE NOT EXISTS (
    SELECT 1
    FROM Orders o
    WHERE o.customerId = c.id
);


-- Person and Address — LEFT JOIN
Returns people even if they do not have an address.
SELECT p.firstName,
       p.lastName,
       a.city,
       a.state
FROM Person p
LEFT JOIN Address a
ON p.personId = a.personId;


-- Second-Highest Salary

SELECT MAX(salary) AS second_highest_salary
FROM Employee
WHERE salary < (
    SELECT MAX(salary)
    FROM Employee
);


This returns the second-highest distinct salary, or NULL if there is no second distinct value.


