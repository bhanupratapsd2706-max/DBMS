--INNER JOIN
/*
Returns matching rows from both tables.
SELECT Students.name, Departments.dept_name
FROM Students
INNER JOIN Departments
ON Students.dept_id = Departments.dept_id;
*/


-- LEFT JOIN
/*
Returns all rows from the left table and matching rows from the right table.
SELECT Students.name, Departments.dept_name
FROM Students
LEFT JOIN Departments
ON Students.dept_id = Departments.dept_id;
/*


-- RIGHT JOIN
/*
Returns all rows from the right table and matching rows from the left table.
SELECT Students.name, Departments.dept_name
FROM Students
RIGHT JOIN Departments
ON Students.dept_id = Departments.dept_id;
*/

-- FULL OUTER JOIN
/*
Supported directly by Oracle and PostgreSQL, but not by MySQL.
SELECT Students.name, Departments.dept_name
FROM Students
FULL OUTER JOIN Departments
ON Students.dept_id = Departments.dept_id;
*/

-- CROSS JOIN
/*
Returns every possible combination of rows.
SELECT Students.name, Departments.dept_name
FROM Students
CROSS JOIN Departments;
*/

-- SELF JOIN
/*
A table joins with itself. Example: employees and their managers.
SELECT e.name AS Employee,
       m.name AS Manager
FROM Employees e
LEFT JOIN Employees m
ON e.manager_id = m.emp_id;
*/

This example assumes the Employees table contains manager_id.


Subqueries
Find students older than the average age:
SELECT name, age
FROM Students
WHERE age > (
    SELECT AVG(age)
    FROM Students
);


Find students belonging to department 10 or 20:
SELECT name
FROM Students
WHERE dept_id IN (
    SELECT dept_id
    FROM Departments
    WHERE dept_id IN (10, 20)
);


25. EXISTS and NOT EXISTS
-- Departments having students
SELECT d.dept_name
FROM Departments d
WHERE EXISTS (
    SELECT 1
    FROM Students s
    WHERE s.dept_id = d.dept_id
);


-- Departments without students
SELECT d.dept_name
FROM Departments d
WHERE NOT EXISTS (
    SELECT 1
    FROM Students s
    WHERE s.dept_id = d.dept_id
);


26. UNION and UNION ALL
SELECT name FROM Students
UNION
SELECT dept_name FROM Departments;


UNION removes duplicate rows; UNION ALL keeps duplicates.
SELECT name FROM Students
UNION ALL
SELECT dept_name FROM Departments;


Both queries must return the same number of compatible columns.
27. NULL Handling
-- Find missing emails
SELECT * FROM Students
WHERE email IS NULL;

-- Find available emails
SELECT * FROM Students
WHERE email IS NOT NULL;


Replace NULL values in query results:

SELECT name, COALESCE(email, 'No email') AS email
FROM Students;


-- CASE Statement
SELECT name, age,
